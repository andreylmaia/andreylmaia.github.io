---
import {url} from '../lib/site';
const en = url('en');
const pt = url('pt');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Andrey Maia</title>
<link rel="canonical" href={new URL(en,Astro.site)}/>
<noscript><meta http-equiv="refresh" content={`0;url=${en}`}/></noscript>

</head>
<body><a href={en}>English</a> · <a href={pt} lang="pt-BR">Português</a>
  <script>
    import {campaignParams} from '../lib/analytics';
    let locale = 'en';
    try { if (localStorage.getItem('am-language') === 'pt') locale = 'pt'; } catch {}
    const target = document.querySelector<HTMLAnchorElement>(locale === 'pt' ? 'a[lang=pt-BR]' : 'a');
    if (target) {
      const next = new URL(target.href);
      next.search = campaignParams(location.search);
      location.replace(next);
    }
  </script>
</body>
</html>
