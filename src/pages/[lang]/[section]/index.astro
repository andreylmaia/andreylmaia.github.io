---
import {measurementId} from '../../../lib/analytics';
import AnalyticsConsent from '../../../components/AnalyticsConsent.astro';
import PageHeading from '../../../components/PageHeading.astro';
import Shell from '../../../layouts/Shell.astro';
import Catalog from '../../../components/Catalog.astro';
import LabPreview from '../../../components/LabPreview.astro';
import AboutIntro from '../../../components/AboutIntro.astro';
import Connect from '../../../components/Connect.astro';
import ConnectPage from '../../../components/ConnectPage.astro';
import Indicators from '../../../components/Indicators.astro';
import {copy,labIds,locales,sections,type Locale} from '../../../lib/site';
export const getStaticPaths = () => locales.flatMap(lang => sections.map(section => ({params:{lang,section}})));
const locale = Astro.params.lang as Locale;
const section = Astro.params.section as typeof sections[number];
const t = copy[locale];
const i = sections.indexOf(section);
const descriptors = {
  insights:t.pillars.map(p => p[0]).join(' · '), labs:t.labsDesc, intelligence:t.intelDesc, library:t.libraryDesc,
  about:undefined, connect:t.connectDesc, privacy:undefined,
};
const headings = {insights:t.nav[0],labs:t.labs,intelligence:t.intelligence,library:t.library,about:t.about,connect:t.connect.join(' '),privacy:t.nav[6]};
---
<Shell {locale} title={t.nav[i]} description={descriptors[section] || (section === 'about' ? t.bio : t.privacy)} route={section}>
  {section === 'connect' ? <ConnectPage {locale}/> : <>
  <PageHeading title={headings[section]} description={descriptors[section]} label={headings[section] !== t.nav[i] ? t.nav[i] : undefined}/>
  <div class="wrap page-body">
    {(section === 'insights' || section === 'library') && <Catalog {section} {locale}/>}
    {section === 'labs' && <div class="labs-grid">{labIds.map((_,index) => <LabPreview {locale} {index}/>)}</div>}
    {section === 'intelligence' && <Indicators {locale}/>}
    {section === 'about' && <><AboutIntro {locale}/><Connect {locale} location="about"/></>}
    {section === 'privacy' && <div class="privacy-copy">
      <p>{t.privacy}</p>
      {measurementId() ? <>
        <p>{t.analytics.disclosure}</p>
        <p>{t.analytics.exclusions}</p>
        <a class="text-link" href="https://policies.google.com/technologies/partner-sites">{t.analytics.google}</a>
        <AnalyticsConsent {locale} settings={true}/>
      </> : <p>{t.analytics.unconfigured}</p>}
    </div>}
  </div>
  </>}
</Shell>
