---
import Icon from './Icon.astro';
import {indicators} from '../data/indicators';
import {copy,language,type Locale} from '../lib/site';
const {locale,limit} = Astro.props as {locale:Locale;limit?:number};
const pt = locale === 'pt';
const markets = {BR:pt?'Brasil':'Brazil',CN:'China',US:pt?'Estados Unidos':'United States'};
const date = (value:string) => new Intl.DateTimeFormat(language(locale),{dateStyle:'medium',timeZone:'UTC'}).format(new Date(value));
---
{indicators.length ? <div class="market-grid">{indicators.slice(0,limit).map(item => <article class="market"><span class="eyebrow">{markets[item.market]}</span><h3>{item.title[locale]}</h3><strong>{new Intl.NumberFormat(language(locale)).format(item.value)} {item.unit[locale]}</strong><p>{pt?'Observação':'Observation'} · <time datetime={item.observationDate}>{date(item.observationDate)}</time><br/>{pt?'Atualização':'Updated'} · <time datetime={item.updatedAt}>{date(item.updatedAt)}</time></p>{item.methodology && <p>{item.methodology[locale]}</p>}<a class="text-link" href={item.sourceUrl}>{item.source}<Icon name="diagonal" size={14}/></a></article>)}</div> : <div class="market-placeholder"><div class="market-grid">{Object.entries(markets).map(([key,name]) => <div class="market"><Icon name="globe"/><h3>{name}</h3><span class="eyebrow">{key}</span></div>)}</div><p>{copy[locale].unavailable}</p></div>}
