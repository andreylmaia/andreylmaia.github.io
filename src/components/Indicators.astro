---
import Icon from './Icon.astro';
import {countries, indicatorGroups, type CountryIndicator} from '../data/indicators';
import {copy, language, url, type Locale} from '../lib/site';

const {locale, homepage = false} = Astro.props as {locale: Locale; homepage?: boolean};
const t = copy[locale];
const labels = t.indicators;
const groups = Object.entries(indicatorGroups) as [keyof typeof indicatorGroups, typeof indicatorGroups[keyof typeof indicatorGroups]][];
const initial = countries.find(country => country.code === 'BR') ?? countries[0];
const Heading = homepage ? 'h3' : 'h2';
const format = (item: CountryIndicator) => {
  if (item.value === null) return '—';
  if (item.unit === 'text') return item.value;
  const options: Intl.NumberFormatOptions = {};
  if (item.unit === 'compact' || item.unit === 'compactCurrency') options.notation = 'compact';
  if (item.unit === 'percent') {
    options.style = 'percent';
    options.maximumFractionDigits = 2;
  }
  if (item.unit === 'currency' || item.unit === 'compactCurrency') {
    options.style = 'currency';
    options.currency = item.currency;
    options.currencyDisplay = 'narrowSymbol';
    options.maximumFractionDigits = item.unit === 'compactCurrency' ? 1 : 2;
  }
  return new Intl.NumberFormat(language(locale), options).format(item.unit === 'percent' ? item.value / 100 : item.value);
};
---

<div data-country-overview>
  <div class="overview-heading">
    {homepage && <div><h2>{t.intelligence}</h2><p>{t.intelDesc}</p></div>}
    {initial && <label class="country-selector">
      {labels.country}
      <select data-country-select>
        {countries.map(country => <option value={country.code} selected={country === initial}>{country.name[locale]}</option>)}
      </select>
    </label>}
  </div>
  {!initial && <p class="empty">{t.unavailable}</p>}
  {countries.map(country => {
    const sources = new Map(Object.values(country.indicators).flatMap(item => item.source ? [[item.source.name, item.source.url]] : []));
    return <div data-country-panel={country.code} hidden={country !== initial}>
      <div class="indicator-columns">
        {groups.map(([group, ids]) => <div>
          <Heading>{labels.groups[group]}</Heading>
          <dl>
            {ids.map(id => <div class="indicator-row">
              <dt>{labels.metrics[id]}</dt>
              <dd aria-label={country.indicators[id].value === null ? labels.noValue : undefined}>{format(country.indicators[id])}</dd>
            </div>)}
          </dl>
        </div>)}
      </div>
      <footer class="indicator-footer">
        <div class="source-summary">
          {labels.sources}:
          {[...sources].map(([name, link], i) => <>{i > 0 && <span aria-hidden="true"> · </span>} <a href={link}>{name}</a></>)}
          {sources.size === 0 && <> · {labels.pending}</>}
        </div>
        <details>
          <summary>{labels.methodology}</summary>
          <div class="indicator-columns source-columns">
            {groups.map(([group, ids]) => <div>
              <Heading>{labels.groups[group]}</Heading>
              <dl>
                {ids.map(id => {
                  const item = country.indicators[id];
                  return <div class="source-entry">
                    <dt>{labels.metrics[id]}</dt>
                    <dd>
                      {item.source ? <a class="text-link" href={item.source.url}>{item.source.name}<Icon name="diagonal" size={12}/></a> : labels.pending}
                      {item.referencePeriod && <div>{item.value === null ? labels.requestedPeriod : labels.referencePeriod} · <time datetime={item.referencePeriod}>{item.referencePeriod}</time></div>}
                      {item.updatedAt && <div>{labels.reviewed} · <time datetime={item.updatedAt}>{item.updatedAt}</time></div>}
                      {item.methodology && <div>{item.methodology[locale]}</div>}
                    </dd>
                  </div>;
                })}
              </dl>
            </div>)}
          </div>
        </details>
        {homepage && <a class="text-link overview-link" href={url(locale, 'intelligence')}>{t.view}<Icon name="arrow" size={16}/></a>}
      </footer>
    </div>;
  })}
</div>

<script>
  for (const overview of document.querySelectorAll('[data-country-overview]')) {
    const selector = overview.querySelector<HTMLSelectElement>('[data-country-select]');
    if (!selector || selector.options.length < 2) continue;
    const panels = overview.querySelectorAll<HTMLElement>('[data-country-panel]');
    selector.addEventListener('change', () => {
      for (const panel of panels) panel.hidden = panel.dataset.countryPanel !== selector.value;
    });
  }
</script>

<style>
  .overview-heading{display:flex;align-items:end;justify-content:space-between;gap:12px 24px;flex-wrap:wrap;margin-bottom:16px}
  .overview-heading h2{margin:0}
  .overview-heading p{margin-top:4px}
  .country-selector{display:grid;gap:4px;margin-inline-start:auto;color:var(--muted);font-size:13px}
  .country-selector select{min-height:36px;padding:4px 24px 4px 10px;border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--ink);font:inherit}
  .indicator-columns{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px clamp(18px,3vw,44px)}
  .indicator-columns :is(h2,h3){margin:0;padding-bottom:7px;font-size:16px;color:var(--accent)}
  .indicator-columns dl,.indicator-columns dd{margin:0}
  .indicator-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:baseline;gap:8px;border-top:1px solid var(--border);padding-block:5px;font-size:14px}
  .indicator-row dd{text-align:end;font-variant-numeric:tabular-nums;font-weight:600}
  .indicator-footer{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:baseline;margin-top:12px;padding-top:10px;border-top:1px solid var(--border);color:var(--muted);font-size:13px}
  .indicator-footer details[open]{flex-basis:100%;order:1}
  .indicator-footer summary{cursor:pointer;color:var(--accent);width:fit-content}
  .source-summary a{color:var(--accent);text-decoration:underline;text-underline-offset:2px}
  .overview-link{margin-inline-start:auto}
  .source-columns{padding-block:8px}
  .source-entry{padding-block:6px;border-top:1px solid var(--border)}
  .source-entry dt{font-weight:600;color:var(--ink)}
  @media(max-width:680px){
    .indicator-columns{grid-template-columns:1fr}
  }
</style>
