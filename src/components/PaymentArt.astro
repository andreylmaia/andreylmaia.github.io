---
import Icon from './Icon.astro';
import {copy, language, type Locale} from '../lib/site';
const {locale} = Astro.props as {locale: Locale};
const t = copy[locale];
const money = (amount:number) => new Intl.NumberFormat(language(locale), {style:'currency',currency:'BRL'}).format(amount);
---
<figure class="payment-art" aria-label={t.demo}>
  <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
  <svg class="circuit" viewBox="0 0 540 465" aria-hidden="true">
    <path d="M47 53h181v107h217v209h53M28 385h95V225h325M322 30v58h158v104" fill="none" stroke="currentColor" stroke-dasharray="3 6"/>
    <g fill="currentColor"><circle cx="47" cy="53" r="3"/><circle cx="498" cy="369" r="3"/><circle cx="28" cy="385" r="3"/><circle cx="322" cy="30" r="3"/></g>
  </svg>
  <div class="art-label"><span></span>{t.demo}</div>
  <div class="art-card volume-card">
    <span>{t.volume}</span>
    <svg viewBox="0 0 160 68" aria-hidden="true">
      <path d="M0 15h160M0 35h160M0 55h160" stroke="currentColor" opacity=".15"/>
      <path d="M0 56 18 51 32 55 47 43 62 48 76 30 91 33 106 19 122 25 139 12 160 4V68H0Z" fill="currentColor" opacity=".10"/>
      <path d="M0 56 18 51 32 55 47 43 62 48 76 30 91 33 106 19 122 25 139 12 160 4" fill="none" stroke="currentColor" stroke-width="2"/>
    </svg>
  </div>
  <div class="art-card payment-card">
    <div class="art-icon"><Icon name="diagonal" size={19}/></div>
    <div><span>{t.payment}</span><strong>{money(100)}</strong></div>
  </div>
  <div class="art-card ledger-card">
    <div class="art-card-heading"><Icon name="layers" size={16}/><b>{t.ledger}</b></div>
    <div class="ledger-lines">
      <div><small>{t.debit}</small><span>{t.liability}</span><b>{money(102)}</b></div>
      <div><small>{t.credit}</small><span>{t.asset}</span><b>{money(100)}</b></div>
      <div><small>{t.credit}</small><span>{t.revenue}</span><b>{money(2)}</b></div>
    </div>
    <div class="balance-label"><Icon name="check" size={14}/>{t.balanced}</div>
  </div>
  <div class="art-card settlement-card"><div class="art-icon"><Icon name="check" size={17}/></div><b>{t.settled}</b></div>
</figure>
