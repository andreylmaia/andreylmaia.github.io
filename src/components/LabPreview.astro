---
import {copy, labIds, language, url, type Locale} from '../lib/site';
import Icon from './Icon.astro';
const {locale, index} = Astro.props as {locale:Locale; index:number};
const t = copy[locale];
const [title, description] = t.tools[index];
const money = new Intl.NumberFormat(language(locale),{style:'currency',currency:'BRL'});
---
<a class:list={['lab-preview', index === 0 && 'lab-feature']} href={url(locale,'labs/' + labIds[index])}>
  <div class="lab-preview-content"><span class="tile-icon"><Icon name={['layers','activity','trend'][index]}/></span><h3>{title}</h3><p>{description}</p><span class="lab-go"><Icon name="arrow" size={18}/></span></div>
  {index === 0 && <div class="lab-sample" aria-hidden="true"><span>{t.ledger}</span><div><b>{t.debit}</b><code>+ {money.format(102)}</code></div><div><b>{t.credit}</b><code>− {money.format(100)}</code></div><div><b>{t.credit}</b><code>− {money.format(2)}</code></div><small><Icon name="check" size={14}/>{t.balanced}</small></div>}
  {index === 1 && <svg class="lab-mini" width="70" height="50" viewBox="0 0 70 50" aria-hidden="true"><path d="M7 43h57" stroke="currentColor" opacity=".25"/><path d="M13 42V29h9v13m10 0V19h9v23m10 0V9h9v33" fill="none" stroke="currentColor" stroke-width="2"/></svg>}
  {index === 2 && <svg class="lab-mini" width="70" height="50" viewBox="0 0 70 50" aria-hidden="true"><path d="M8 42h54M8 42V7" stroke="currentColor" opacity=".25"/><path d="M9 40q32-4 53-31M9 40q33-3 53-17" fill="none" stroke="currentColor" stroke-width="2"/><path d="M9 40q33-3 53-17" fill="none" stroke="var(--surface)" stroke-width="2" stroke-dasharray="2 4"/></svg>}
</a>
