---
import ProfilePortrait from './ProfilePortrait.astro';
import {brand,copy,type Locale} from '../lib/site';
const {locale} = Astro.props as {locale:Locale};
---
<div class="about-intro">
  <ProfilePortrait {locale}/>
  <div><div class="eyebrow">{brand.name}</div><p>{copy[locale].bio}</p><slot/></div>
</div>
