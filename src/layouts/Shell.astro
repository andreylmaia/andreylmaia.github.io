---
import '../styles/site.css';
import {analytics} from '../lib/analytics';
import Icon from '../components/Icon.astro';
import {brand, copy, language, other, sections, url, asset, type Locale} from '../lib/site';

const {locale, title, description, route = '', alternate, switchUrl, image, schema, noindex = false} = Astro.props as {
  locale: Locale; title?: string; description?: string; route?: string; alternate?: string | null; switchUrl?: string;
  image?: string; schema?: object; noindex?: boolean;
};
const t = copy[locale];
const current = noindex ? url(undefined,'404.html').slice(0,-1) : url(locale,route);
const sibling = alternate === undefined ? url(other(locale),route) : alternate;
const canonical = new URL(current, Astro.site);
const pageTitle = title ? `${title} · ${brand.name}` : `${brand.name} · ${t.hero.join(' ')}`;
const summary = description || t.intro;
const socialImage = new URL(asset(image || (locale === 'pt' ? 'social-pt.png' : 'social.png')), Astro.site);
const labels = locale === 'pt' ? {skip:'Ir para o conteúdo', menu:'Menu', theme:'Alternar tema', nav:'Navegação principal', footer:'Navegação do rodapé'} : {skip:'Skip to content', menu:'Menu', theme:'Toggle theme', nav:'Main navigation', footer:'Footer navigation'};
---
<!doctype html>
<html lang={language(locale)}>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={summary}/>
  {noindex && <meta name="robots" content="noindex"/>}
  <title>{pageTitle}</title>
  <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml"/>
  <link rel="canonical" href={canonical}/>
  {!noindex && <link rel="alternate" hreflang={language(locale)} href={canonical}/>}
  {sibling && <link rel="alternate" hreflang={language(other(locale))} href={new URL(sibling,Astro.site)}/>}
  <link rel="alternate" type="application/rss+xml" title={t.nav[0]} href={url(locale) + 'rss.xml'}/>
  <meta property="og:title" content={pageTitle}/>
  <meta property="og:description" content={summary}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:locale" content={locale === 'pt' ? 'pt_BR' : 'en_US'}/>
  <meta property="og:type" content={schema && '@type' in schema && schema['@type'] === 'Article' ? 'article' : 'website'}/>
  <meta property="og:image" content={socialImage}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={pageTitle}/>
  <meta name="twitter:description" content={summary}/>
  <meta name="twitter:image" content={socialImage}/>
  {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org', ...schema}).replace(/</g,'\\u003c')}/>}
  {analytics && <script is:inline defer src={analytics.scriptUrl}/>}
  <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('am-theme') === 'dark' ? 'dark' : 'light'; } catch {}</script>
</head>
<body>
  <a class="skip-link" href="#main">{labels.skip}</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="wordmark" href={url(locale)}>{brand.wordmark}<b>.</b></a>
      <nav class="main-nav" id="main-nav" aria-label={labels.nav}>
        {sections.slice(0,6).map((section,i) => <a class:list={[section === 'connect' && 'nav-contact']} href={url(locale,section)} aria-current={route.split('/')[0] === section ? 'page' : undefined}>{t.nav[i]} {section === 'connect' && <Icon name="diagonal" size={14}/>}</a>)}
      </nav>
      <div class="header-actions">
        <a class="language" data-language={other(locale)} href={switchUrl || sibling || url(other(locale))} lang={language(other(locale))} aria-label={locale === 'en' ? 'PT · Português do Brasil' : 'EN · English'}><Icon name="globe" size={16}/>{other(locale).toUpperCase()}</a>
        <button class="icon-button theme-toggle" type="button" aria-label={labels.theme} aria-pressed="false"><span class="moon"><Icon name="moon" size={17}/></span><span class="sun"><Icon name="sun" size={17}/></span></button>
        <button class="icon-button menu-toggle" type="button" aria-label={labels.menu} aria-controls="main-nav" aria-expanded="false"><Icon name="menu"/></button>
      </div>
    </div>
  </header>
  <main id="main"><slot/></main>
  <footer class="footer">
    <div class="wrap">
      <div class="footer-top">
        <div><a class="wordmark" href={url(locale)}>{brand.wordmark}<b>.</b></a><p>{t.signature}</p></div>
        <nav aria-label={labels.footer}>{sections.slice(0,6).map((section,i) => <a href={url(locale,section)}>{t.nav[i]}</a>)}</nav>
        <div class="social">
          {brand.linkedin && <a href={brand.linkedin}>LinkedIn <Icon name="diagonal" size={13}/></a>}
          <a href={brand.github}>GitHub <Icon name="diagonal" size={13}/></a>
          {brand.email && <a href={'mailto:' + brand.email}>Email <Icon name="diagonal" size={13}/></a>}
        </div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getUTCFullYear()} {brand.name}</span><a href={url(locale,'privacy')}>{t.nav[6]}</a></div>
    </div>
  </footer>
  <script>
    const theme = document.querySelector<HTMLButtonElement>('.theme-toggle');
    const root = document.documentElement;
    theme?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
    theme?.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      theme.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
      try { localStorage.setItem('am-theme', root.dataset.theme); } catch {}
    });
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    toggle?.addEventListener('click', () => toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true')));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
        toggle.setAttribute('aria-expanded','false');
        toggle.focus();
      }
    });
    document.querySelector<HTMLElement>('[data-language]')?.addEventListener('click', event => {
      const link = event.currentTarget as HTMLElement;
      try { localStorage.setItem('am-language', link.dataset.language || 'en'); } catch {}
    });
  </script>
</body>
</html>
